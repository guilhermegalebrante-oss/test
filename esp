-- ==========================================
-- 2. VARREDURA INSTANTÂNEA NA RAM (GETGC)
-- ==========================================
local function buscarOvosNaMemoria()
    local listaOvos = {}
    
    for _, obj in pairs(getgc(true)) do
        if type(obj) == "table" then
            pcall(function()
                -- Procura tabelas que parecem conter os dados dos ovos/pets ativos
                if obj.MoneyPerSecond and (obj.UID or obj.Id) then
                    local nome = "Ovo Desconhecido"
                    if type(obj.ItemData) == "table" then
                        nome = obj.ItemData.Id or obj.ItemData.Type or "Ovo"
                    elseif obj.Name then
                        nome = obj.Name
                    end
                    
                    local valor = tonumber(obj.MoneyPerSecond) or 0
                    if valor > 0 then
                        table.insert(listaOvos, {
                            Nome = tostring(nome):gsub(" Egg", ""),
                            Valor = valor,
                            Raridade = valor >= 1000000 and "Cosmic" or (valor >= 250000 and "Mythic" or "Legendary")
                        })
                    end
                end
            end)
        end
    end
    
    return listaOvos
end

-- Executa IMEDIATAMENTE ao injetar
task.spawn(function()
    local ovos = buscarOvosNaMemoria()
    
    -- Ordena do mais caro para o mais barato
    table.sort(ovos, function(a, b) return a.Valor > b.Valor end)
    
    for i, ovo in ipairs(ovos) do
        local isBest = (i == 1)
        createEggCard(i, ovo.Nome, ovo.Raridade, ovo.Valor, isBest)
    end
    
    if #ovos == 0 then
        createEggCard(1, "Nenhum ovo ativo", "Normal", 0, true)
    end
end)
