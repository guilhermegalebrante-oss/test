    ValLabel.Parent = Card
end

-- ==========================================
-- 2. BUSCA LEVE NA MEMÓRIA (RODA S1 VEZ)
-- ==========================================
task.spawn(function()
    local ovosEncontrados = {}
    
    -- Executa o getgc de forma isolada apenas na inicialização
    for _, obj in pairs(getgc(true)) do
        if type(obj) == "table" then
            pcall(function()
                if obj.MoneyPerSecond and (obj.UID or obj.Id) then
                    local uid = tostring(obj.UID or obj.Id)
                    local nomeBicho = "Ovo"
                    
                    if type(obj.ItemData) == "table" then
                        nomeBicho = obj.ItemData.Id or obj.ItemData.Type or "Ovo"
                    elseif obj.Name then
                        nomeBicho = obj.Name
                    end
                    
                    nomeBicho = tostring(nomeBicho):gsub(" Egg", "")
                    local valor = tonumber(obj.MoneyPerSecond) or 0

                    if not ovosEncontrados[uid] then
                        ovosEncontrados[uid] = {Nome = nomeBicho, Valor = valor}
                        
                        -- Cria o Billboard direto no modelo físico do mapa se já existir
                        local modeloNoChao = Workspace:FindFirstChild(uid, true)
                        if modeloNoChao and modeloNoChao:IsA("Model") and not modeloNoChao:FindFirstChild("LennonTag") then
                            local Billboard = Instance.new("BillboardGui")
                            Billboard.Name = "LennonTag"
                            Billboard.Size = UDim2.new(0, 150, 0, 35)
                            Billboard.StudsOffset = Vector3.new(0, 3, 0)
                            Billboard.AlwaysOnTop = true
                            Billboard.Adornee = modeloNoChao
                            Billboard.Parent = Folder

                            local TextLabel = Instance.new("TextLabel")
                            TextLabel.Size = UDim2.new(1, 0, 1, 0)
                            TextLabel.BackgroundTransparency = 1
                            TextLabel.Text = string.format("🥚 %s\n⚡ %s/s", nomeBicho, formatNumber(valor))
                            TextLabel.TextColor3 = Color3.fromRGB(50, 255, 100)
                            TextLabel.TextStrokeTransparency = 0
                            TextLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                            TextLabel.Font = Enum.Font.GothamBold
                            TextLabel.TextSize = 12
                            TextLabel.Parent = Billboard
                        end
                    end
                end
            end)
        end
    end

    -- Transforma em lista ordenada e joga na UI
    local listaFinal = {}
    for _, dados in pairs(ovosEncontrados) do
        table.insert(listaFinal, dados)
    end
    table.sort(listaFinal, function(a, b) return a.Valor > b.Valor end)

    for i, ovo in ipairs(listaFinal) do
        if i <= 20 then -- Mostra até os 20 principais
            addCard(i, ovo.Nome, ovo.Valor)
        end
    end
end)

print("[LENNON HUB] Carregado de forma leve!")
