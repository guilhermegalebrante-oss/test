local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- 1. ROUBANDO O MÓDULO
local MutationsModule = nil
for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("ModuleScript") and obj.Name == "Mutations" then
        MutationsModule = require(obj)
        break
    end
end

if not MutationsModule then
    warn("Módulo não encontrado!")
    return
end

-- 2. FUNÇÃO PARA FORMATAR
local function formatValue(v)
    if v >= 1000000 then return string.format("%.2fM", v/1000000) end
    if v >= 1000 then return string.format("%.2fK", v/1000) end
    return tostring(math.floor(v))
end

-- 3. FUNÇÃO PARA ACHAR OS IDS INSTANTANEAMENTE
local function getEggIds()
    local ids = {}
    -- Tenta pegar da função All
    if type(MutationsModule.All) == "function" then
        local sucesso, resultado = pcall(MutationsModule.All)
        if sucesso and type(resultado) == "table" then
            ids = resultado
        end
    elseif type(MutationsModule.All) == "table" then
        ids = MutationsModule.All
    end

    -- Se não achou, tenta pegar da função Ids
    if #ids == 0 and type(MutationsModule.Ids) == "function" then
        local sucesso, resultado = pcall(MutationsModule.Ids)
        if sucesso and type(resultado) == "table" then
            ids = resultado
        end
    elseif #ids == 0 and type(MutationsModule.Ids) == "table" then
        ids = MutationsModule.Ids
    end

    -- Se ainda não achou, varre a memória (getgc) por tabelas que tenham uma propriedade "Id" ou "Mutation" numérica
    if #ids == 0 then
        local items = getgc()
        for i = 1, #items do
            local item = items[i]
            if type(item) == "table" then
                -- Procura por uma tabela que seja uma lista de números (IDs)
                local isIdList = true
                local count = 0
                for k, v in pairs(item) do
                    if type(k) == "number" and (type(v) == "number" or type(v) == "string") then
                        count = count + 1
                        if type(v) == "number" and v > 0 then
                            table.insert(ids, v)
                        end
                    else
                        isIdList = false
                        break
                    end
                end
                if count > 5 then
                    break
                end
            end
        end
    end

    -- Último recurso: loop manual de 1 até 500 (instantâneo)
    if #ids == 0 then
        for i = 1, 500 do
            table.insert(ids, i)
        end
    end

    return ids
end

-- 4. COLETA OS DADOS DOS OVOS
local function collectEggs()
    local ids = getEggIds()
    local ovos = {}

    for _, id in ipairs(ids) do
        -- Tenta pegar os dados do ovo usando Get (se existir)
        local dadosOvo = nil
        if type(MutationsModule.Get) == "function" then
            local sucesso, resultado = pcall(MutationsModule.Get, id)
            if sucesso and resultado ~= nil then
                dadosOvo = resultado
            end
        end

        -- Se o Get falhar, tenta RollTable
        if not dadosOvo and type(MutationsModule.RollTable) == "table" then
            dadosOvo = MutationsModule.RollTable[id]
        end

        -- Se os dados existirem, calcula nome e valor
        if dadosOvo ~= nil then
            local nome = "Ovo " .. id
            local raridade = "?"
            local valor = 0

            pcall(function()
                if MutationsModule.EggDisplayName then
                    local n = MutationsModule.EggDisplayName(id)
                    if typeof(n) == "string" and n ~= "" then nome = n end
                end
            end)

            pcall(function()
                if MutationsModule.RarityFactorFor then
                    local r = MutationsModule.RarityFactorFor(id)
                    if typeof(r) == "string" then raridade = r end
                end
            end)

            pcall(function()
                if MutationsModule.EarningsFor then
                    local v = MutationsModule.EarningsFor(id)
                    if typeof(v) == "number" and v > 0 then valor = v end
                end
            end)

            if valor > 0 then
                table.insert(ovos, {Nome = nome, Raridade = raridade, Valor = valor})
            end
        end
    end

    table.sort(ovos, function(a, b) return a.Valor > b.Valor end)
    return ovos
end

