local function getRarityColor(r)
    local rLower = string.lower(r or "")
    if string.find(rLower, "cosmic") then return Color3.fromRGB(180, 0, 255) end
    if string.find(rLower, "mythic") then return Color3.fromRGB(255, 100, 0) end
    if string.find(rLower, "legend") then return Color3.fromRGB(255, 215, 0) end
    if string.find(rLower, "epic") then return Color3.fromRGB(150, 0, 255) end
    if string.find(rLower, "rare") then return Color3.fromRGB(0, 150, 255) end
    return Color3.fromRGB(180, 180, 180)
end

local function formatValue(v)
    if v >= 1000000 then return string.format("%.2fM", v/1000000) end
    if v >= 1000 then return string.format("%.2fK", v/1000) end
    return tostring(math.floor(v))
end

