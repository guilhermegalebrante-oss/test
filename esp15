-- 1. ROUBANDO O MÓDULO E GRAMPEANDO O "GET"
local MutationsModule = nil
local GetOriginal = nil
local IdsCapturados = {}

for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("ModuleScript") and obj.Name == "Mutations" then
        local sucesso, modulo = pcall(require, obj)
        if sucesso then
            MutationsModule = modulo
            -- Grampo na função Get
            if type(MutationsModule.Get) == "function" then
                GetOriginal = MutationsModule.Get
                MutationsModule.Get = function(id, ...)
                    table.insert(IdsCapturados, id)
                    return GetOriginal(id, ...)
                end
            end
        end
        break
    end
end

print("✅ Grampo instalado na função Get.")

-- 2. FUNÇÃO PARA VARRER A MEMÓRIA (GETGC) E ACHAR OS DADOS
local function varrerMemoria()
    local ovos = {}
    local itens = getgc()
    
    -- Varre toda a memória RAM
    for i = 1, #itens do
        local item = itens[i]
        if type(item) == "table" then
            -- Procura tabelas com Nome, Valor e Raridade
            local nome = item.DisplayName or item.Name or item.EggName
            local valor = item.Value or item.Price or item.Earnings
            local raridade = item.Rarity or item.Rareness
            
            -- Se tiver nome e valor, é um ovo
            if type(nome) == "string" and type(valor) == "number" and valor > 0 then
                table.insert(ovos, {Nome = nome, Valor = valor, Raridade = raridade or "?"})
            end
        end
    end

    -- Se não achou nada na memória, tenta usar os IDs capturados pelo grampo
    if #ovos == 0 and #IdsCapturados > 0 then
        for _, id in ipairs(IdsCapturados) do
            local nome = "Ovo " .. tostring(id)
            local valor = 0
            local raridade = "?"

            pcall(function()
                if MutationsModule.EggDisplayName then nome = MutationsModule.EggDisplayName(id) end
            end)
            pcall(function()
                if MutationsModule.RarityFactorFor then raridade = MutationsModule.RarityFactorFor(id) end
            end)
            pcall(function()
                if MutationsModule.EarningsFor then valor = MutationsModule.EarningsFor(id) end
            end)

            if valor > 0 then
                table.insert(ovos, {Nome = nome, Valor = valor, Raridade = raridade})
            end
        end
    end

    -- Ordena do maior para o menor
    table.sort(ovos, function(a, b) return a.Valor > b.Valor end)
    return ovos
end

