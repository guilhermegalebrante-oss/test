-- 1. ROUBANDO O MÓDULO
local MutationsModule = nil
for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("ModuleScript") and obj.Name == "Mutations" then
        MutationsModule = require(obj)
        break
    end
end

if not MutationsModule then
    warn("Módulo não encontrado!")
    return
end

-- 2. FUNÇÃO PARA FORMATAR VALORES (Ex: 1271M, 1.97M)
local function formatValue(v)
    if v >= 1000000 then return string.format("%.2fM", v/1000000) end
    if v >= 1000 then return string.format("%.2fK", v/1000) end
    return tostring(math.floor(v))
end

-- 3. COLETA OS OVOS INSTANTANEAMENTE (LOOP SEGURO DE IDs)
local function collectEggs()
    local ovos = {}
    
    -- Testa IDs de 1 até 200 (você pode aumentar se quiser, mas 200 é o suficiente)
    for id = 1, 200 do
        local dadosOvo = nil
        
        -- Tenta pegar os dados usando a função Get
        if type(MutationsModule.Get) == "function" then
            local sucesso, resultado = pcall(MutationsModule.Get, id)
            if sucesso and resultado ~= nil then dadosOvo = resultado end
        end

        -- Se Get falhar, tenta RollTable (se existir)
        if not dadosOvo and type(MutationsModule.RollTable) == "table" then
            pcall(function() dadosOvo = MutationsModule.RollTable[id] end)
        end

        -- Se os dados existirem, calcula nome, raridade e valor
        if dadosOvo ~= nil then
            local nome = "Ovo " .. id
            local raridade = "?"
            local valor = 0

            -- Pega o Nome
            pcall(function()
                if MutationsModule.EggDisplayName then
                    local n = MutationsModule.EggDisplayName(id)
                    if typeof(n) == "string" and n ~= "" then nome = n end
                end
            end)

            -- Pega a Raridade
            pcall(function()
                if MutationsModule.RarityFactorFor then
                    local r = MutationsModule.RarityFactorFor(id)
                    if typeof(r) == "string" and r ~= "" then raridade = r end
                end
            end)

            -- Pega o Valor (Calculadora)
            pcall(function()
                if MutationsModule.EarningsFor then
                    local v = MutationsModule.EarningsFor(id)
                    if typeof(v) == "number" and v > 0 then valor = v end
                end
            end)

            -- Se conseguiu um valor > 0, adiciona na lista
            if valor > 0 then
                table.insert(ovos, {Nome = nome, Raridade = raridade, Valor = valor})
            end
        end
    end

    -- Ordena do mais caro para o mais barato
    table.sort(ovos, function(a, b) return a.Valor > b.Valor end)
    return ovos
end

