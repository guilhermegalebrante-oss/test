-- 5. FUNÇÃO DE CORES DE RARIDADE
local function getRarityColor(r)
    local rLower = string.lower(r or "")
    if string.find(rLower, "cosmic") then return Color3.fromRGB(180, 0, 255) end
    if string.find(rLower, "mythic") then return Color3.fromRGB(255, 100, 0) end
    if string.find(rLower, "legend") then return Color3.fromRGB(255, 215, 0) end
    if string.find(rLower, "epic") then return Color3.fromRGB(150, 0, 255) end
    if string.find(rLower, "rare") then return Color3.fromRGB(0, 150, 255) end
    return Color3.fromRGB(180, 180, 180)
end

-- 6. RENDERIZAÇÃO NA TELA (MOSTRAR OVOS)
local function renderEggs(ovos)
    for _, child in pairs(List:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    if #ovos > 0 then
        for i, egg in ipairs(ovos) do
            if i > 10 then break end -- Top 10

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 60)
            row.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            row.BorderSizePixel = 0
            row.Parent = List
            
            local rank = Instance.new("TextLabel")
            rank.Size = UDim2.new(0, 40, 1, 0)
            rank.Text = "#" .. i
            rank.TextColor3 = Color3.new(0.5, 0.5, 0.5)
            rank.Font = Enum.Font.GothamBold
            rank.TextXAlignment = Enum.TextXAlignment.Center
            rank.Parent = row

            local nome = Instance.new("TextLabel")
            nome.Size = UDim2.new(0, 180, 0, 25)
            nome.Position = UDim2.new(0, 40, 0, 5)
            nome.Text = egg.Nome
            nome.TextColor3 = Color3.new(1, 1, 1)
            nome.Font = Enum.Font.GothamBold
            nome.TextScaled = true
            nome.TextXAlignment = Enum.TextXAlignment.Left
            nome.Parent = row

            local rar = Instance.new("TextLabel")
            rar.Size = UDim2.new(0, 180, 0, 20)
            rar.Position = UDim2.new(0, 40, 0, 30)
            rar.Text = egg.Raridade
            rar.TextColor3 = getRarityColor(egg.Raridade)
            rar.Font = Enum.Font.Gotham
            rar.TextSize = 14
            rar.TextXAlignment = Enum.TextXAlignment.Left
            rar.Parent = row

            local val = Instance.new("TextLabel")
            val.Size = UDim2.new(0, 120, 1, 0)
            val.Position = UDim2.new(1, -130, 0, 0)
            val.Text = formatValue(egg.Valor)
            val.TextColor3 = Color3.new(1, 1, 1)
            val.Font = Enum.Font.GothamBold
            val.TextSize = 15
            val.TextXAlignment = Enum.TextXAlignment.Right
            val.Parent = row
        end
    else
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 0, 40)
        empty.Text = "Nenhum ovo encontrado."
        empty.TextColor3 = Color3.new(1, 1, 1)
        empty.Parent = List
    end
end

